# Git
.git
.gitignore
.gitattributes

# Python bytecode / build artifacts
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# IDE / Editor
.claude/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docs / non-runtime — exclude markdown by default; explicitly re-include the
# files served by the in-app Wiki tab (/api/wiki/<slug> reads paths listed in
# src/serving/app.py:WIKI_DOCS). Order matters: re-includes must follow the
# broad *.md.
*.md
!README.md
!SETUP.md
!ATTRIBUTION.md
!TODO.md
!docs/**/*.md
!infra/ec2/README.md
!infra/aws/README.md

# Tests
tests/
**/tests/
.pytest_cache/
.coverage
htmlcov/

# CI
.github/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Analysis / scratch (not needed in production containers). After the src/
# migration these scripts moved to themed subdirs under src/, so the
# .dockerignore prefixes shifted accordingly.
analysis_output/
src/analysis/
src/benchmarking/
src/tuning/
src/scripts/
conftest.py

# Training code — inference doesn't import it.
src/batch/

# Infra — only the README.md files are surfaced in the wiki (re-included
# above); the bootstrap shell scripts, IAM/JSON policies, and systemd units
# don't belong in the runtime image.
infra/**/*.sh
infra/**/*.json
infra/**/*.service
infra/**/*.timer

# Training + inference data — fetched from S3 at container startup via
# src.shared.model_sync.sync_data_from_s3 (keeps the image ~60 MB smaller).
data/

# Top-level directories that only contain README pointers into src/ — README files
# only, no runtime artifacts.
models/
notebooks/

# Per-position outputs — models fetched from S3 at startup via
# src.shared.model_sync.sync_models_from_s3; figures are always local scratch.
**/outputs/models/
**/outputs/figures/

# Benchmark / tuning artifacts (local scratch, not needed at runtime).
# benchmark_history/ is intentionally NOT excluded — the serving image
# bundles it as the floor for the History tab, and
# src.shared.model_sync.sync_benchmark_history_from_s3 layers on any
# newer runs uploaded since the last image build.
benchmark_*.json
tune_*.json
tune_*.db
*.db

# Dockerfiles themselves (don't need copies inside the image).
Dockerfile
Dockerfile.*
.dockerignore

# Local dev databases / caches.
*.sqlite
*.sqlite3
