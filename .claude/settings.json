{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(git fetch origin:*)",
      "Bash(aws s3 ls:*)",
      "Bash(/Users/alex/miniforge3/bin/ruff check:*)",
      "Bash(aws batch describe-jobs:*)",
      "Bash(gh run watch:*)",
      "Bash(aws batch describe-job-definitions:*)",
      "Bash(aws logs get-log-events:*)",
      "Bash(aws batch list-jobs:*)",
      "Bash(gh label list:*)",
      "Bash(aws batch describe-compute-environments:*)",
      "Bash(aws service-quotas get-service-quota:*)",
      "Bash(gh variable list:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/memory-sync-stop.sh",
            "statusMessage": "Syncing agent memories to S3"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-pr-create.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-pr-merge.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-worktree-path.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-pr.sh"
          }
        ]
      }
    ]
  },
  "showThinkingSummaries": true,
  "precomputeCompactionEnabled": true,
  "autoDreamEnabled": true,
  "fallbackModel": ["sonnet", "haiku"]
}
