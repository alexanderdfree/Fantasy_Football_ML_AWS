{
  "version": 1,
  "id": "training-speed-smoke",
  "steps": [
    {
      "id": "paired-ab",
      "kind": "ab",
      "spec": "src.tuning.ab_example",
      "positions": ["RB"],
      "options": {"seeds": [42], "stacked_seeds": false},
      "env": {"FF_NN_FIXED_EPOCHS": "2"}
    },
    {
      "id": "nn-search",
      "kind": "nn_tune",
      "positions": ["RB"],
      "options": {"n_trials": 1, "n_jobs": 1, "stacked_seeds": 0},
      "env": {"FF_NN_FIXED_EPOCHS": "2"}
    },
    {
      "id": "tree-search",
      "kind": "lgbm_tune",
      "positions": ["RB"],
      "options": {"n_trials": 1, "n_jobs": 1, "seeds": [42]}
    },
    {
      "id": "fresh-benchmark",
      "kind": "benchmark",
      "positions": ["RB"],
      "options": {"seed": 42},
      "env": {"FF_NN_FIXED_EPOCHS": "2"}
    }
  ]
}
