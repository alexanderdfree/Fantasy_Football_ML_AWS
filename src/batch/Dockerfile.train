# syntax=docker/dockerfile:1.7
# Slim CUDA base + pip-installed torch — cold-start optimization: shrink the
# per-Spot-host image pull (the dominant chunk of the ~258 s cold start; see
# docs/batch_design.md §"Cold-start optimization"). Replaces the conda-based
# pytorch/pytorch:2.12.0-cuda12.6-cudnn9-runtime base (~3.7 GB compressed) with
# nvidia/cuda:*-base (~86 MB) + the cu126 torch wheel, which bundles its own
# CUDA libs — so we do NOT layer them on a *-cudnn-runtime base (~2 GB) that
# would double-count cudnn/cublas and erase the win. torch VERSION is pinned
# identical to the old base (2.12.0 / cu126) so training numerics stay
# comparable: this is a packaging change, not a torch upgrade.
#
# Base image served via an optional ECR pull-through cache (strategy 2c). When
# PULL_THROUGH_PREFIX is set, the base is pulled from ECR instead of Docker Hub
# — first pull in the region seeds the ECR cache, every subsequent Batch
# instance pulls from the local AWS network. batch-image.yml derives the
# registry from the account + vars.AWS_REGION and overrides this at build time;
# leave unset to pull from Docker Hub directly. nvidia/cuda is an org image, so
# it routes through the cache exactly like pytorch/pytorch did.
ARG PULL_THROUGH_PREFIX=
FROM --platform=linux/amd64 ${PULL_THROUGH_PREFIX}nvidia/cuda:12.6.3-base-ubuntu24.04

# System deps the conda base provided that the slim CUDA base lacks:
#  - python3: Ubuntu 24.04 ships CPython 3.12, matching the project's cp312
#    wheels (numpy/pandas/pyarrow/sklearn/lightgbm all resolve cp312 manylinux).
#    The `python` symlink keeps the `python -m ...` ENTRYPOINT working without
#    pulling python-is-python3 (and its universe dependency).
#  - python3-dev + g++: g++ is needed by torch.compile's Inductor CPU vec-ISA
#    probe on first forward pass (InvalidCxxCompiler otherwise, PR #185); the
#    pair also covers any C-extension sdist lacking a cp312 wheel.
#  - libgomp1: OpenMP runtime for LightGBM + scikit-learn (conda bundled it).
#  - ca-certificates: HTTPS trust store for boto3 / S3.
# --no-install-recommends keeps the layer lean. Placed before the uv install so
# a requirements change doesn't invalidate it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-dev g++ libgomp1 ca-certificates && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# uv: pinned single-binary installer (~10x faster than pip, parallel wheel
# downloads). Pin a specific minor so this COPY layer doesn't invalidate every
# time astral publishes a new release.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /opt/ml/code

# uv hardlinks wheels from its cache into site-packages by default; the BuildKit
# cache mount lives on a different overlay, so hardlinking falls back to copy —
# explicit copy mode skips the failed probe and silences the CI warning.
ENV UV_LINK_MODE=copy
# requirements.txt carries the cu126 torch wheel via an --extra-index-url
# (mirrors requirements-gpu.txt). unsafe-best-match lets uv resolve torch +
# its nvidia-*-cu12 deps from the pytorch index while everything else resolves
# from PyPI (matches train-batch.yml's UV_INDEX_STRATEGY).
ENV UV_INDEX_STRATEGY=unsafe-best-match

# Single uv-install layer: any requirements.txt change invalidates exactly one
# cached layer. The cache mount on /root/.cache/uv persists wheel downloads
# across builds (CI mirrors this via actions/cache — see batch-image.yml).
# --break-system-packages: Ubuntu's system Python 3.12 is PEP 668 marked.
COPY src/batch/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages -r requirements.txt

# Fail the build (on the CPU CI runner) if the install is incoherent, instead of
# discovering it on the first GPU Batch job. torch imports fine CPU-side, so this
# catches unresolved deps / missing system libs (e.g. libgomp). GPU/CUDA-lib
# loading is validated by the post-build Batch smoke run (docs/batch_design.md).
RUN python -c "import torch, lightgbm, sklearn, scipy, pandas, numpy, pyarrow; print('import smoke OK; torch', torch.__version__)"

# All Python source lives under src/. .dockerignore handles coarse exclusions
# (Flask UI, scratch scripts, tests); src/ is the only Python copy needed.
COPY src/ src/

ENTRYPOINT ["python", "-m", "src.batch.train"]
