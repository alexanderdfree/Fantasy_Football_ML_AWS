# syntax=docker/dockerfile:1.7
# Base image served via an optional ECR pull-through cache (strategy 2c).
# When PULL_THROUGH_PREFIX is set, the pytorch base is pulled from ECR
# instead of Docker Hub — first pull in the region seeds the ECR cache,
# every subsequent Batch instance pulls from the local AWS network.
#
# Example (region is parameterized — batch-image.yml derives the registry
# from the account + ``vars.AWS_REGION`` since PR #308, so this is illustrative
# only; the build always overrides it with the live region's registry):
#   --build-arg PULL_THROUGH_PREFIX=123456789012.dkr.ecr.<region>.amazonaws.com/dockerhub/
# Leave unset to pull directly from Docker Hub (original behavior).
ARG PULL_THROUGH_PREFIX=
FROM --platform=linux/amd64 ${PULL_THROUGH_PREFIX}pytorch/pytorch:2.12.0-cuda12.6-cudnn9-runtime

# torch.compile (added in PR #183 via _maybe_compile) lazy-compiles graphs at
# first forward pass. Inductor's CPU vec-ISA probe (pick_vec_isa →
# cpp_compiler_search) needs a working C++ compiler to dry-build a vectorized
# fingerprint, even when the model is on CUDA — attention masking / padding
# / dtype casts can fall back to CPU codegen. The pytorch:*-runtime base is
# intentionally minimal (no toolchain), so without g++ Inductor raises
# ``InductorError: InvalidCxxCompiler`` on the first forward pass and kills
# training (PR #185's train-ec2 run reproduced this). Place this layer before
# the uv install so a Python-deps change doesn't invalidate it.
# ``--no-install-recommends`` keeps the addition lean (~50 MB on a ~7 GB base).
RUN apt-get update && \
    apt-get install -y --no-install-recommends g++ && \
    rm -rf /var/lib/apt/lists/*

# uv: pinned single-binary installer (~10x faster than pip + parallel wheel
# downloads). Pin to a specific minor so this COPY layer doesn't invalidate
# every time astral publishes a new release.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /opt/ml/code

# uv defaults to hardlinking wheels from its cache into site-packages. The
# BuildKit cache mount below lives on a different overlay than the image
# root, so hardlinking always fails and falls back to copy — explicit copy
# mode skips the failed probe and silences the warning in CI.
ENV UV_LINK_MODE=copy

# Single uv-install layer: any change to requirements.txt invalidates exactly
# one cached layer. The cache mount on /root/.cache/uv persists wheel
# downloads across builds (CI mirrors this via actions/cache — see
# batch-image.yml). --break-system-packages is required because the pytorch
# base image's system Python 3.12 is PEP 668 marked. The nflverse data feed
# (nflreadpy + polars) installs cleanly from requirements.txt — no --no-deps
# workaround or extra appdirs/fastparquet pins like the deprecated nfl_data_py
# required. nflreadpy is imported transitively at startup (src.{k,dst}.data →
# src.data.nfl_source) even though no nflverse fetch happens at training time.
COPY src/batch/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages -r requirements.txt

# All Python source lives under src/ after the layout migration.
# .dockerignore handles the coarse exclusions (Flask UI, scratch scripts,
# tests); src/ is the only Python copy needed. tune_lgbm.py is at
# src/tuning/tune_lgbm.py and ships with the rest of src/ — retune-lgbm.yml
# invokes it via ``python -m src.tuning.tune_lgbm``.
COPY src/ src/

ENTRYPOINT ["python", "-m", "src.batch.train"]
