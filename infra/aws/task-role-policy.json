{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelsFromS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::ff-predictor-training/models/*"
    },
    {
      "Sid": "ListBenchmarkHistory",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::ff-predictor-training",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "models/benchmark_history/",
            "models/benchmark_history/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadUpcomingArtifactVersions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::ff-predictor-training/models/predictions_cache/upcoming_week.json"
    },
    {
      "Sid": "ListUpcomingArtifactVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::ff-predictor-training",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "models/predictions_cache/upcoming_week.json"
        }
      }
    }
  ]
}
